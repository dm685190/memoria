[Unit]
Description=Create a verified Memoria backup
Documentation=https://github.com/dm685190/memoria/blob/main/docs/operations.md
After=memoria-verify.service

[Service]
Type=oneshot
User=memoria
Group=memoria
EnvironmentFile=/etc/memoria.env
ExecStart=/opt/memoria/.venv/bin/memoria backup --db ${MEMORIA_DB} --output-dir ${MEMORIA_BACKUP_DIR}
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/memoria /var/backups/memoria
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
