[Unit]
Description=Verify Memoria evidence database
Documentation=https://github.com/dm685190/memoria/blob/main/docs/operations.md

[Service]
Type=oneshot
User=memoria
Group=memoria
EnvironmentFile=/etc/memoria.env
ExecStart=/opt/memoria/.venv/bin/memoria verify --db ${MEMORIA_DB}
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/memoria /var/backups/memoria
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
